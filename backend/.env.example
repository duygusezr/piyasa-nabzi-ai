# ── Gemini (Google AI Studio: https://aistudio.google.com/app/apikey) ────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── DeepL (İngilizce haber çevirisi — ücretsiz 500k karakter/ay) ─────────────
# Kayıt: https://www.deepl.com/pro#developer  (Free tier yeterli)
# Not: Free plan anahtarları ":fx" ile biter  (örn: abc123:fx)
DEEPL_API_KEY=your_deepl_api_key_here

# ── Binance (isteğe bağlı — public API key olmadan da çalışır) ────────────────
# Daha yüksek rate limit için: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=

# ── CoinGecko (isteğe bağlı — Binance fallback) ───────────────────────────────
# Free tier API key: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# ── TCMB EVDS (isteğe bağlı — tarihsel seri, makro göstergeler) ──────────────
# Kayıt: https://evds2.tcmb.gov.tr/
# Not: Günlük kur XML'i (today.xml) key gerektirmez, her zaman çalışır.
TCMB_API_KEY=

# ── GDELT (ücretsiz, auth gerektirmez — otomatik çalışır) ────────────────────
# https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/
GDELT_MAX_RECORDS=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Üretimde tek domain:   CORS_ORIGINS=https://piyasanabzi.com
# Üretimde çok domain:   CORS_ORIGINS=https://piyasanabzi.com,https://www.piyasanabzi.com
# Herkese açık:          CORS_ORIGINS=*
# Boş bırakılırsa localhost:5173 ve :3000 varsayılan olarak izin verilir
CORS_ORIGINS=*

# ── Genel ─────────────────────────────────────────────────────────────────────
# true → tüm servisler mock veri kullanır (internet bağlantısı olmayan demo için)
USE_MOCK_DATA=false

# Önbellek süresi (saniye)
CACHE_TTL_SECONDS=60

# HTTP istek zaman aşımı (saniye)
REQUEST_TIMEOUT=10
